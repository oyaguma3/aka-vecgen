# Valkey のパスワード（必須）。
VALKEY_PASSWORD=change-me

# ---- 認証ベクターAPI ----

# mTLS リスナーを公開するホスト側のアドレスとポート。
VECGEN_AV_TLS_PUBLISH=0.0.0.0:8443

# 自己署名のサーバー証明書を初回起動時に自動生成するとき、SAN に入れるホスト名と IP アドレス。
# クライアントが接続に使う名前や IP アドレスをカンマ区切りで指定する。
# 生成済みの証明書には反映されない（av-cert reset コマンドで作り直せる）。
VECGEN_AV_TLS_HOSTS=localhost,127.0.0.1,aka-vecgen

# ---- 管理API ----

# 管理クライアントは環境変数ではなく、ファイル secrets/admin-clients に書く（README の「管理API」）。

# 管理API を公開するホスト側のアドレスとポート。
# aka-provisioner を別ホストで動かす場合は、そのホストから届くアドレス（サービス用の WireGuard など）に変える。
VECGEN_ADMIN_PUBLISH=127.0.0.1:9443

# 管理API 用の自己署名サーバー証明書の SAN。生成済みの証明書には反映されない
# （admin-cert reset コマンドで作り直し、SIGHUP で反映する）。
VECGEN_ADMIN_TLS_HOSTS=localhost,127.0.0.1,aka-vecgen

# ---- その他 ----

# 同一ホスト上の別の compose プロジェクトと共有する Docker ネットワークの名前。
VECGEN_SHARED_NETWORK=aka-av

# ログレベル（debug / info / warn / error）。
VECGEN_LOG_LEVEL=info
# 監査ログの Valkey の Stream の保持件数の上限（管理API の /audit-logs で見る分）。
VECGEN_AUDIT_MAX=100000
# 監査ログの日ごとのファイル（audit/）をノードで持つ日数。前の日までのファイルは gzip で圧縮する。
VECGEN_AUDIT_RETENTION_DAYS=14
# 鍵の読み出しの口を有効にする（別の生成源への移し替えのときだけ。使い終えたら false に戻す）。
VECGEN_KEY_EXPORT=false

# 起動ログと管理API の /status に出すバージョン（ビルドのときに埋め込む）。
# 空なら dev。git のコミットを出す場合は、ビルドのときに指定する（運用ガイド 8 章）。
VECGEN_VERSION=
